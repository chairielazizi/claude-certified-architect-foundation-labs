# Only needed for --live runs. Offline (default) runs need no credentials.
# The SDKs also pick up an `ant auth login` profile, so this is optional.
ANTHROPIC_API_KEY=

# Optional overrides
# LAB_LIVE=1                          # same as passing --live to every lab
# LAB_MODEL=claude-opus-5-5           # default model for live runs
# LAB_FORCED_TOOL_MODEL=claude-opus-5 # model used by labs that demo tool_choice "any"/forced
